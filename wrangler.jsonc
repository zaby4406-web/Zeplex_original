{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeplex-ai",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "vars": {
    "CF_ACCOUNT_ID": "5d04576517bb25ffcf314059bf17a239",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "secrets": {
    "required": ["CF_API_TOKEN"]
  }
}
